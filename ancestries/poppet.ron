#![enable(unwrap_variant_newtypes)]
(
  id: Identifier(
    id: "Poppet",
    traits: ["Rare", "Construct", "Humanoid", "Poppet"],
  ),
  size: [Small],
  speed: {"Walk": 25},
  base_hp: 6,
  at_boost: [Con, Cha, Free],
  at_flaw: [Dex],
  base_langs: ["Common"],
  rec_langs: ["Draconic", "Dwarven", "Elven", "Gnomish", "Goblin", "Sylvan"],
  features: [
    Flavor(
      id: Identifier(
        id: "Darkvision",
        traits: [],
      ),
      flavor: "You can see in darkness and dim light just as well as you can see in bright light, though your vision in darkness is in black and white.",
    ),
    Circumstance(
      id: Identifier(
        id: "Constructed",
        traits: [],
      ),
      circumstances: [
        (
          stats: Some([Fortitude, Reflex, Will]),
          proficiency: None,
          circumstance: Some(["Death", "Disease", "Poison", "Drained", "Paralyzed", "Sickened"]),
          bonus: +1,
        ),
      ],
      flavor: "The materials of your body resist ailments that assail the flesh. You gain a +1 circumstance bonus to saving throws against death effects, disease, and poison as well as to saving throws against effects that would give you the drained, paralyzed, or sickened conditions. Your spark of life means that you're a living creature, and you can be healed by positive energy and harmed by negative energy as normal."
    ),
    Condition(Weakness(Fire), 1),
  ],
)