#![enable(unwrap_variant_newtypes)]
(
  id: Identifier(
    id: "Anadi",
    traits: ["Rare", "Anadi", "Humanoid"],
  ),
  size: [Medium],
  speed: {"Walk": 25},
  base_hp: 8,
  at_boost: [Dex, Wis, Free],
