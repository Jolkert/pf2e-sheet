#![enable(unwrap_variant_newtypes)]
(
  meta: Meta(
    id: "Android",
    traits: ["Rare", "Android", "Humanoid"],
    flavor: Some("Technological wonders from another world, androids have synthetic bodies and living souls. Their dual nature makes them quick-thinking and calm under pressure, but comfortable in stillness and solitude."),
    legacy: true,
  ),
  size: [Medium],
  speed: {"Walk": 25},
  base_hp: 8,
  at_boost: [Dex, Int, Free],
  at_flaw: [Cha],
  base_langs: ["Common", "Androffan"],
  rec_langs: ["Abyssal", "Celestial", "Draconic", "Dwarven", "Undercommon", "Utopian"],
  features: [
    Flavor(
      id: "Low-Light Vision",
      traits: [],
      flavor: Some("You can see in dim light as though it were bright light, and you ignore the concealed condition due to dim light."),
      legacy: false,
    ),
    Circumstance(
      meta: Meta(
        id: "Constructed",
        traits: [],
        flavor: Some("Your synthetic body resists ailments better than those of purely biological organisms. You gain a +1 circumstance bonus to saving throws against diseases, poisons, and radiation."),
        legacy: false,
      ),
      circumstances: [
        (
          stats: Some([Fortitude, Reflex, Will]),
          proficiency: None,
          circumstance: Some(["Disease", "Poison", "Radiation"]),
          bonus: "+1",
        ),
      ],
    ),
    Circumstance(
      meta: Meta (
        id: "Emotionally Unaware",
        traits: [],
        flavor: Some("You find it difficult to understand and express complex emotions. You take a –1 circumstance penalty to Diplomacy and Performance checks, and on Perception checks to Sense Motive."),
        legacy: false,
      ),
      circumstances: [
        (
          stats: Some([Perception]),
          proficiency: None,
          circumstance: Some(["Sense Motive"]),
          bonus: "-1",
        ),
        (
          stats: Some([Diplomacy, Performance]),
          proficiency: None,
          circumstance: None,
          bonus: "-1",
        ),
      ],
    )
  ],
)