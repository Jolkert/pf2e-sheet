                    stats: Some([Fortitude, Reflex]),
                    proficiency: None,
                    circumstance: Some(["attempts to Reposition, Shove, or Trip you", "saving throws against spells or effects that attempt to force you to move or knock you prone"]),
                    bonus: "+2",
                ),
            ],
        ),
    ],
