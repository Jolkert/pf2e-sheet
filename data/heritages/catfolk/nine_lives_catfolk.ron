(
    meta: (
        id: "Nine Lives Catfolk",
        traits: [],
        flavor: Some("Your family has always seems to bounce back from disaster, not through physical hardiness or specialized skill, but from sheer luck. Other catfolk whisper that you have nine lives. While you're dying, you don't add your dying value to the DC of your recovery checks (this means the DC is typically 10). In addition, you gain the Diehard general feat."),
        legacy: false,
    ),
    prereqs: [],
    features: [
        Feat("diehard"),
    ],
)