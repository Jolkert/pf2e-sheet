#![enable(unwrap_variant_newtypes)]
(
  meta: Meta(
    id: "Centaur",
    traits: ["Uncommon", "Beast", "Centaur", "Humanoid"],
    flavor: Some("Centaurs are half-human, half-horse nomads who range wild and free across their ancestral lands. They're survivalists with a long history of teaching and instruction who stand firm in the face of danger using their skill at archery, herbalism, and magic."),
    legacy: false,
  ),
  size: [Large],
  speed: (
    walk: 30,
    burrow: 0,
    climb: 0,
    fly: 0,
    swim: 0,
  ),
  base_hp: 8,
  at_boost: [Str, Wis, Free],
  at_flaw: [Cha],
  base_langs: ["Common", "Fey"],
  rec_langs: ["Arboreal", "Cyclops", "Dwarven", "Elven", "Gnomish", "Halfling", "Jotun"],
  features: [
    Flavor(
      id: "Darkvision",
      traits: [],
      flavor: Some("You can see in darkness and dim light just as well as you can see in bright light, though your vision in darkness is in black and white."),
      legacy: false,
    ),
    Flavor(
      id: "Mount",
      traits: [],
      flavor: Some("Your equine body is well suited for carrying trusted allies. A PC can ride you if they are one size category smaller than you (Medium size, for most centaurs), rather than needing to be two size categories smaller."),
      legacy: false,
    ),
    Flavor(
      id: "Robust",
      traits: [],
      flavor: Some("You increase your maximum and encumbered Bulk limits by 2."),
      legacy: false,
    ),
  ],
)