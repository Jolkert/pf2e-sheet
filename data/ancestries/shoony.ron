#![enable(unwrap_variant_newtypes)]
(
  meta: Meta(
    id: "Shoony",
    traits: ["Rare", "Humanoid", "Shoony"],
    flavor: Some("Diminutive humanoids who resemble squat, bipedal dogs, shoonies are sometimes mistaken for weak and insular pacifists. However, their sheer perseverance, incredible work ethic, and resourceful use of diplomacy make shoonies far from helpless."),
    legacy: true,
  ),
  size: [Small],
  speed: (
    walk: 25,
    burrow: 0,
    climb: 0,
    fly: 0,
    swim: 0,
  ),
  base_hp: 6,
  at_boost: [Dex, Cha, Free],
  at_flaw: [Con],
  base_langs: ["Common", "Shoony"],
  rec_langs: ["Dwarven", "Gnomish", "Goblin", "Halfling", "Terran"],
  features: [
    Flavor(
      id: "Low-Light Vision",
      traits: [],
      flavor: Some("You can see in dim light as though it were bright light, so you ignore the concealed condition due to dim light."),
      legacy: false,
    ),
    Flavor(
      id: "Blunt Snout",
      traits: [],
      flavor: Some("Your small, blunt snout and labyrinthine sinus system make you resistant to phenomena that assail the nose. When you roll a saving throw against inhaled threats (such as inhaled poisons) and olfactory effects (such as xulgath stench), you get the outcome one degree of success better than the result of your roll."),
      legacy: false,
    ),
  ],
)