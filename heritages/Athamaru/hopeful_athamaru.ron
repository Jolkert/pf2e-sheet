        Size([Large]);
        Aura(
            meta: (
                id: "Hopeful Athamaru Aura",
                traits: [],
                flavor: None,
                legacy: false,
            )
            range: 10,
            effects: [
                Circumstance(
                    meta: (
                        id: "Hopeful Athamaru Aura",
                        traits: ["emotion", "mental"],
                        flavor: None,
                        legacy: false,
                    ),
                    circumstances [
                        (
                            stats: Some([Fortitude, Reflex, Will]),
                            proficiency: None,
                            circumstance: Some(["fear"]),
                            bonus: "+1",
                        ),
                    ],
                )
            ],
        )
    ],
